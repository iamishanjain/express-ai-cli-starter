{
  "manifestVersion": 1,
  "id": "language/typescript",
  "version": "1.0.0",
  "category": "language",
  "option": "typescript",
  "label": "TypeScript",
  "order": 1,
  "default": true,
  "variables": {
    "ext": "ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.0"
  },
  "files": [
    {
      "from": "files/tsconfig.json.tpl",
      "to": "tsconfig.json"
    }
  ]
}
